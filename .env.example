# Copy these names into the ignored .dev.vars file for local Wrangler development.
# Keep secret values out of this tracked example file.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Enable password-reset email only after Resend verifies equip.newvisiontv.app.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Equip <no-reply@equip.newvisiontv.app>
