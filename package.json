{
  "name": "equip-registration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/verification.test.ts",
    "pages:dev": "wrangler pages dev --d1 DB=equip-db --compatibility-date 2024-11-01",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply equip-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply equip-db --remote"
  },
  "dependencies": {
    "@remixicon/react": "4.9.0",
    "better-auth": "^1.1.20",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-aria-components": "1.17.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^3.109.2"
  }
}
