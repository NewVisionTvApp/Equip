{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equip",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://equip.app-f19.workers.dev",
    "RESEND_FROM_EMAIL": "Equip <no-reply@equip.newvisiontv.app>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGNbqjqS9wFBQqnu"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "equip-db",
      "database_id": "e9246976-f995-45a2-b2a1-0eee4f917767",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
